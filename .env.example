# Credentials lith-call looks for. Copy to .env and fill in what you have.
#
# Lookup order, highest first (see LITH_CALL_BACKLOG.md § Credentials):
#   1. shell environment      2. <repo>/.env
#   3. ~/.hermes/.env         4. ~/.hermes/auth.json  (OAuth tokens only)
#
# A key here is scoped to lith. A key in ~/.hermes/.env is also ingested by
# Hermes into its own credential pool. Prefer this file unless you want both.
#
# .env and .env.* are gitignored. Never commit a real key.

XAI_API_KEY=
OPENAI_API_KEY=
MINIMAX_API_KEY=

# Optional, sent as OpenAI-Organization / OpenAI-Project when present.
# Not required for /v1/images/generations.
# OPENAI_ORG_ID=
# OPENAI_PROJECT_ID=
